{
  "name": "auto-assign",
  "description": "Automatically add reviewers/assignees to issues/PRs",
  "version": "3.0.2",
  "main": "dist/index.js",
  "repository": "https://github.com/step-security/wow-actions-auto-assign",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint 'src/**/*.{js,ts}?(x)' --fix",
    "build": "ncc build src/index.ts --minify",
    "prebuild": "run-s lint clean"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "pretty-quick — staged"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "license": "MIT",
  "author": "step-security",
  "dependencies": {
    "@actions/core": "^2.0.0",
    "@actions/github": "^8.0.0",
    "@wow-actions/parse-inputs": "^2.0.1",
    "axios": "^1.20.0",
    "lodash.samplesize": "^4.2.0"
  },
  "devDependencies": {
    "@bubkoo/eslint-config": "^1.3.0",
    "@bubkoo/tsconfig": "^1.1.0",
    "@types/lodash.samplesize": "^4.2.7",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^18.11.18",
    "@vercel/ncc": "^0.36.1",
    "eslint": "^8.33.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.3",
    "pretty-quick": "^3.1.3",
    "rimraf": "^4.1.2",
    "typescript": "^4.9.4"
  }
}
